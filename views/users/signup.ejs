<% layout('/layouts/boilerplate') %>

<div class="row mt-3">
    <h1 class="col-6 offset-3">Signup on wanderlust</h1>
  <div class="col-8 offset-2">
    <form action="/signup" method="POST" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input name="username" id="username" placeholder="Enter Username" type="text" class="form-control" required>
        <div class="valid-feedback">Looks good!</div>
      </div>
      <div class="mb-3">
        <label for="email" class="form-label">Username</label>
        <input name="email" id="email" placeholder="Enter your email" type="text" class="form-control" required>
      </div>
      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input name="password" id="password" placeholder="Enter your password" type="text" class="form-control" required>
      </div>
      <button class="btn btn-success">signUp</button>
    </form>
  </div>
</div>
